# Expo app configuration. Copy to .env and fill in.
#
# Only EXPO_PUBLIC_* variables reach the app bundle, and they are embedded in
# it at build time — so nothing secret belongs here. The Supabase service role
# key and the Gemini API key live in worker/.env and never leave the worker.

# Where the worker is running.
#
# Local: start it with `cd worker && uvicorn app.main:app --port 8000`.
# A simulator on the same machine can use localhost. A real phone running Expo
# Go cannot — it needs this machine's address on the same wifi, e.g.
# http://192.168.1.23:8000. Find it with `ipconfig` on Windows or
# `ipconfig getifaddr en0` on a Mac.
#
# Once the worker is deployed (BE-11), this becomes its Render URL and nobody
# has to run anything locally.
EXPO_PUBLIC_WORKER_URL=http://localhost:8000
