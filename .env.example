# Expo app configuration. Copy to .env and fill in.
#
# Only EXPO_PUBLIC_* variables reach the app bundle, and they are embedded in
# it at build time — so nothing secret belongs here. The Supabase service role
# key and the Gemini API key live in worker/.env and never leave the worker.

# Where the worker is running. The deployed one, which is what you want
# unless you are changing the worker itself -- it redeploys from main on its
# own and nobody has to run anything locally.
#
# The free plan sleeps after 15 minutes idle, so the first analysis after a
# quiet patch takes ~50s to start. That is the cold start, not a hang.
#
# Only override this if you are working on the worker. A simulator on the
# same machine can use http://localhost:8000; a real phone running Expo Go
# cannot -- localhost is the phone -- so it needs this machine's address on
# the same wifi, e.g. http://192.168.1.23:8000 (`ipconfig` on Windows,
# `ipconfig getifaddr en0` on a Mac).
#
# These are read at build time, so restart Expo with `-c` after changing one.
# A reload will not pick it up.
EXPO_PUBLIC_WORKER_URL=https://lyrebird-worker.onrender.com

# Supabase, for real accounts. Both values are from
# Supabase -> Project Settings -> API.
#
# The anon key is safe to ship: it is constrained by row-level security, which
# is why every table carries owner_id. The *service role* key is a different
# thing entirely -- it bypasses RLS completely and belongs only in worker/.env.
# If it ever appears here, every policy we wrote stops meaning anything.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
